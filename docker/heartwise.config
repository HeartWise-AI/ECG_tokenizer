# Minimal config for run_pipeline.bash → inference/preprocessing.py

# Device / loader
device: cuda:0
batch_size: 32
num_workers: 8

# Paths
input_parquet: /app/inputs/data.parquet
output_dir: /app/outputs
ecg_signals_path: /app/ecg_signals
preprocessing_folder: /app/preprocessing

# Checkpoints
bert_checkpoint: /app/checkpoints/bert
tokenizer_checkpoint: /app/checkpoints/ECG_tokenizer_latest/best_model_epoch_10.pt
bert_base_config: config/bert_classifier/base_config.yaml

# QA: restrict to 77 BERT columns only (no heart rate, intervals, MHI-specific). Set to empty to allow optional columns.
# qa_disable_categories: heart_rate,ecg_interval,structural_heart_disease,lvef,acs_severity,culprit_artery,afib_risk

qa_disable_categories: 