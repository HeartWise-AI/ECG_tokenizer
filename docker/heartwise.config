# ECG Tokenizer Inference Pipeline Configuration
# Following DeepECG_Docker pattern: key: value format

# Execution mode: preprocessing, analysis, full_run
mode: full_run

# Device settings
device: cuda:0
cpu_fallback: true

# Processing settings
batch_size: 32
num_workers: 8

# Input/Output paths (when running in Docker)
input_parquet: /app/inputs/data.parquet
output_json: /app/outputs/results.json
output_dir: /app/outputs
checkpoints_dir: /app/checkpoints

# ECG signals path - where raw ECG files are located
# ecg_file_name column values will be joined with this path
ecg_signals_path: /app/ecg_signals

# Model checkpoints
bert_checkpoint: /app/checkpoints/mimic_mhi_bert
tokenizer_checkpoint: /app/checkpoints/ECG_tokenizer_latest/best_model_epoch_10.pt
efficientnet_checkpoint: /app/checkpoints/ECG_Tokenizer_Linear_Probing/ECG_Tokenizer_Linear_Probing/5zg01bx6_20250824-041452/checkpoint_epoch_10.pt
gpt2_checkpoint: /app/checkpoints/ECG_Tokenizer_LLM_Finetuning/ECG_tokenizer_LLM_finetuning_gpt_large/9oxbcfhf_20250728-174237/checkpoint_epoch_10.pt

# Report generation (optional - set to true to enable GPT2 report generation)
enable_report_generation: false

# Required input columns (standardized - not configurable):
#   - ecg_file_name: ECG signal filename (joined with ecg_signals_path)
#   - diagnosis: Text report/diagnosis for BERT classification

# Ground truth source
# BERT predictions from text reports serve as ground truth for evaluating
# signal-based classification (EfficientNet)
use_bert_as_ground_truth: true
bert_threshold: 0.5

# Preprocessing
# Set to true if waveform_path points to raw (non-normalized) signals
apply_psa_normalization: true
psa_region: NA
psa_lead_stats_path: /app/config/lead_stats.json
preprocessing_folder: /app/preprocessing
preprocessing_n_workers: 16

# Classification settings
num_classes: 77
classification_threshold: 0.5

# Text generation settings
max_report_length: 512
generation_temperature: 0.7
generation_top_p: 0.9

# QA generation settings
max_prompts_per_ecg: 2
qa_categories: [RHYTHM, CONDUCTION, INFARCT_ISCHEMIA, CHAMBER_ENLARGEMENT, PERICARDITIS, OTHER]

# Evaluation settings
compute_classification_metrics: true
compute_text_metrics: true
run_llm_judge: false
llm_judge_config_path: /app/config/llm_judge.yaml

# Output settings
verbose: true
